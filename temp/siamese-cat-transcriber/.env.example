# Core storage / runtime
TRANSCRIBER_DATA_DIR=./data
MAX_UPLOAD_MB=500
JOB_WORKERS=2

# auto selects faster-whisper when installed.
TRANSCRIPTION_BACKEND=auto
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Required only for pyannote speaker recognition.
HF_TOKEN=

# Test/demo only. Never enable this expecting real speech recognition.
ALLOW_MOCK_TRANSCRIPTION=0

# Public DJAI routing. The root Node application proxies
# https://www.djai.academy/tools/video-to-text/ to this service.
TRANSCRIBER_PUBLIC_BASE_PATH=/tools/video-to-text
TRANSCRIBER_SESSION_COOKIE=djai_transcriber_session
TRANSCRIBER_SESSION_COOKIE_PATH=/tools/video-to-text
TRANSCRIBER_COOKIE_SECURE=1
