{
  "name": "djai-academy-website",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Root Hostinger deployment entry point for DJAI Academy and public tools.",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build-hostinger.mjs",
    "prestart": "node scripts/ensure-hostinger-build.mjs",
    "start": "node server.js",
    "test:course-interest": "node --test tests/course-interest.test.js",
    "test:supervisor": "node --test tests/service-supervisor.test.js",
    "verify:adsense-recovery": "node scripts/verify-adsense-recovery.mjs",
    "verify:hostinger": "node scripts/audit-hostinger.mjs",
    "hostinger:build": "node scripts/build-hostinger.mjs",
    "hostinger:start": "node server.js"
  },
  "dependencies": {
    "nodemailer": "^9.0.3"
  }
}
