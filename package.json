{
  "name": "djai-academy-website",
  "version": "1.0.0",
  "private": true,
  "description": "Root Hostinger deployment entry point for DJAI Academy and public tools.",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build-hostinger.mjs",
    "prestart": "node scripts/ensure-hostinger-build.mjs",
    "start": "node server.js",
    "test": "npm run test:supervisor && npm run test:localization && npm run test:course-interest && npm run test:cam-pdf-links && npm run test:cam-pdf-product && npm run test:seo-program && npm run test:seo-events && npm run test:commercial-intent && npm run test:pdf-acquisition && npm run test:qr-acquisition && npm run test:tool-acquisition && npm run test:course-ownership && npm run test:seo-integration",
    "test:localization": "node --test tests/chinese-localization-contract.test.mjs tests/localization-content-gates.test.mjs tests/public-route-inventory.test.mjs && node scripts/validate-localization.mjs --root .",
    "test:pdf-acquisition": "node --test djai-pdf-tools/tests/acquisition-routing.test.mjs",
    "test:qr-acquisition": "node --test DJayTools-Free-QR-Generator-Source/tests/acquisition-routing.test.mjs DJayTools-Free-QR-Generator-Source/tests/qr-payload.test.mjs",
    "test:tool-acquisition": "node --test tests/tool-acquisition-routing.test.js",
    "test:course-ownership": "node --test tests/course-intent-ownership.test.js",
    "test:seo-integration": "node --test tests/sitewide-seo-integration.test.js",
    "test:cam-pdf-links": "node --test tests/cam-pdf-play-store-links.test.mjs",
    "test:cam-pdf-product": "node --test djai-academy-homepage/tests/cam-pdf-product-seo.test.mjs djai-academy-homepage/tests/cam-pdf-privacy-policy.test.mjs",
    "test:commercial-intent": "node --test djai-academy-homepage/tests/commercial-intent-separation.test.mjs",
    "test:course-interest": "node --test tests/course-interest.test.js",
    "test:seo-events": "node --test tests/seo-conversion-events.test.mjs",
    "test:seo-program": "node --test tests/seo-program-contract.test.js",
    "test:supervisor": "node --test tests/service-supervisor.test.js",
    "verify:adsense-recovery": "node scripts/verify-adsense-recovery.mjs",
    "verify:hostinger": "node scripts/audit-hostinger.mjs",
    "hostinger:build": "node scripts/build-hostinger.mjs",
    "hostinger:start": "node server.js"
  },
  "dependencies": {
    "nodemailer": "^9.0.3"
  }
}
