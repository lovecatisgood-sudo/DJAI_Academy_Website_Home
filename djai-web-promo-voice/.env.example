# Neon Postgres connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Used in M2+ for Realtime session minting. Never expose this in browser code.
OPENAI_API_KEY="sk-..."

# Optional. Required only when Admin Settings uses voice_provider=gemini.
GEMINI_API_KEY="AIza..."

# Used in M4+ for single-admin cookie auth.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
SESSION_PASSWORD="replace-with-at-least-32-random-characters"
SESSION_SIGNING_SECRET="replace-with-another-32-random-character-secret"
WIDGET_ALLOWED_ORIGINS="https://djai.academy,https://www.djai.academy,https://voice.djai.academy,https://dev.djai.academy"

# Defaults seeded by migration and editable in Admin Settings:
# model_id=gpt-realtime-2.1
# transcription_model=gpt-realtime-whisper
# voice=marin
# voice_provider=openai
# For Gemini Live preview, set voice_provider=gemini and model_id=gemini-3.1-flash-live-preview.
# max_output_tokens=4096 is intentionally fixed in code for V1 voice quality.
